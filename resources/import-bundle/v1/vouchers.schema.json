{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.bms.local/import-bundle/v1/vouchers.schema.json",
    "title": "Disbursement voucher",
    "description": "Item source_key values are unique across all vouchers; liquidations reference them.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "source_key",
        "budget_key",
        "payment_type",
        "status",
        "voucher_date",
        "payee_name",
        "particulars",
        "prepared_at",
        "items"
    ],
    "properties": {
        "source_key": {
            "$ref": "common.schema.json#/$defs/source_key"
        },
        "source_number": {
            "$ref": "common.schema.json#/$defs/source_number"
        },
        "import_note": {
            "$ref": "common.schema.json#/$defs/import_note"
        },
        "budget_key": {
            "$ref": "common.schema.json#/$defs/key_ref"
        },
        "payment_type": {
            "enum": ["cash-advance", "reimbursement", "others"]
        },
        "status": {
            "enum": [
                "prepared",
                "verified",
                "approved",
                "released",
                "closed",
                "cancelled"
            ]
        },
        "voucher_date": {
            "$ref": "common.schema.json#/$defs/date"
        },
        "vendor_key": {
            "$ref": "common.schema.json#/$defs/nullable_key_ref"
        },
        "resident_key": {
            "$ref": "common.schema.json#/$defs/nullable_key_ref"
        },
        "payee_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "pattern": "\\S"
        },
        "payee_address": {
            "type": ["string", "null"],
            "maxLength": 255
        },
        "payee_tin": {
            "type": ["string", "null"],
            "maxLength": 32
        },
        "particulars": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S"
        },
        "responsibility_center": {
            "type": ["string", "null"],
            "maxLength": 150
        },
        "office_unit": {
            "type": ["string", "null"],
            "maxLength": 150
        },
        "treasurer_name": {
            "type": ["string", "null"],
            "maxLength": 255
        },
        "bookkeeper_name": {
            "type": ["string", "null"],
            "maxLength": 255
        },
        "punong_barangay_name": {
            "type": ["string", "null"],
            "maxLength": 255
        },
        "head_of_appropriations_name": {
            "type": ["string", "null"],
            "maxLength": 255
        },
        "prepared_at": {
            "$ref": "common.schema.json#/$defs/date_time"
        },
        "verified_at": {
            "$ref": "common.schema.json#/$defs/nullable_date_time"
        },
        "approved_at": {
            "$ref": "common.schema.json#/$defs/nullable_date_time"
        },
        "released_at": {
            "$ref": "common.schema.json#/$defs/nullable_date_time"
        },
        "closed_at": {
            "$ref": "common.schema.json#/$defs/nullable_date_time"
        },
        "cancelled_at": {
            "$ref": "common.schema.json#/$defs/nullable_date_time"
        },
        "cancel_reason": {
            "type": ["string", "null"],
            "maxLength": 255
        },
        "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "source_key",
                    "account_key",
                    "description",
                    "amount"
                ],
                "properties": {
                    "source_key": {
                        "$ref": "common.schema.json#/$defs/source_key"
                    },
                    "account_key": {
                        "$ref": "common.schema.json#/$defs/key_ref"
                    },
                    "description": {
                        "type": "string",
                        "maxLength": 255,
                        "minLength": 1,
                        "pattern": "\\S"
                    },
                    "amount": {
                        "$ref": "common.schema.json#/$defs/positive_money"
                    }
                }
            }
        }
    }
}
