{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.bms.local/import-bundle/v1/form_templates.schema.json",
    "title": "Form template",
    "description": "Bodies use the unified placeholder syntax, for example {{resident.full_name}} and {{field.purpose}}. The highest version becomes the current version.",
    "type": "object",
    "additionalProperties": false,
    "required": ["source_key", "name", "type", "kind", "versions"],
    "properties": {
        "source_key": {
            "$ref": "common.schema.json#/$defs/source_key"
        },
        "source_number": {
            "$ref": "common.schema.json#/$defs/source_number"
        },
        "import_note": {
            "$ref": "common.schema.json#/$defs/import_note"
        },
        "name": {
            "type": "string",
            "maxLength": 150,
            "minLength": 1,
            "pattern": "\\S"
        },
        "type": {
            "$ref": "common.schema.json#/$defs/label"
        },
        "kind": {
            "enum": ["rich-text", "pdf"]
        },
        "is_active": {
            "type": "boolean"
        },
        "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["version"],
                "properties": {
                    "version": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                    },
                    "body": {
                        "type": ["string", "null"],
                        "maxLength": 200000
                    },
                    "pdf_file": {
                        "$ref": "common.schema.json#/$defs/nullable_attachment_path"
                    },
                    "pdf_file_name": {
                        "type": ["string", "null"],
                        "maxLength": 255
                    },
                    "created_at": {
                        "$ref": "common.schema.json#/$defs/nullable_date_time"
                    },
                    "fields": {
                        "type": "array",
                        "maxItems": 60,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "label", "input_type"],
                            "properties": {
                                "key": {
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9_]{0,39}$"
                                },
                                "label": {
                                    "type": "string",
                                    "maxLength": 120,
                                    "minLength": 1,
                                    "pattern": "\\S"
                                },
                                "input_type": {
                                    "enum": [
                                        "text",
                                        "resident",
                                        "table",
                                        "check",
                                        "date",
                                        "amount"
                                    ]
                                },
                                "is_required": {
                                    "type": "boolean"
                                },
                                "picklist_key": {
                                    "$ref": "common.schema.json#/$defs/nullable_key_ref"
                                }
                            },
                            "if": {
                                "properties": {
                                    "input_type": {
                                        "const": "table"
                                    }
                                }
                            },
                            "then": {
                                "required": ["picklist_key"],
                                "properties": {
                                    "picklist_key": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "pdf_mappings": {
                        "type": "array",
                        "maxItems": 500,
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["pdf_field", "pdf_field_type"],
                            "properties": {
                                "pdf_field": {
                                    "type": "string",
                                    "maxLength": 255,
                                    "minLength": 1,
                                    "pattern": "\\S"
                                },
                                "pdf_field_type": {
                                    "enum": [
                                        "text",
                                        "checkbox",
                                        "radio",
                                        "choice",
                                        "push-button",
                                        "signature"
                                    ]
                                },
                                "pdf_on_state": {
                                    "type": ["string", "null"],
                                    "maxLength": 64
                                },
                                "token": {
                                    "type": ["string", "null"],
                                    "maxLength": 80
                                },
                                "checked_value": {
                                    "type": ["string", "null"],
                                    "maxLength": 64
                                },
                                "unchecked_value": {
                                    "type": ["string", "null"],
                                    "maxLength": 64
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "if": {
        "properties": {
            "kind": {
                "const": "pdf"
            }
        }
    },
    "then": {
        "properties": {
            "versions": {
                "items": {
                    "required": ["pdf_file"],
                    "properties": {
                        "pdf_file": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "else": {
        "properties": {
            "versions": {
                "items": {
                    "required": ["body"],
                    "properties": {
                        "body": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        }
    }
}
