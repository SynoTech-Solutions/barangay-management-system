{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.bms.local/import-bundle/v1/educations.schema.json",
    "title": "Education",
    "type": "object",
    "additionalProperties": false,
    "required": ["source_key", "resident_key", "school", "course"],
    "properties": {
        "source_key": {
            "$ref": "common.schema.json#/$defs/source_key"
        },
        "resident_key": {
            "$ref": "common.schema.json#/$defs/key_ref"
        },
        "school": {
            "$ref": "common.schema.json#/$defs/label"
        },
        "course": {
            "$ref": "common.schema.json#/$defs/label"
        },
        "started_on": {
            "$ref": "common.schema.json#/$defs/nullable_date"
        },
        "ended_on": {
            "$ref": "common.schema.json#/$defs/nullable_date"
        },
        "deleted_at": {
            "$ref": "common.schema.json#/$defs/nullable_date_time"
        }
    }
}
