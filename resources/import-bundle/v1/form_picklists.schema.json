{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.bms.local/import-bundle/v1/form_picklists.schema.json",
    "title": "Form pick list",
    "type": "object",
    "additionalProperties": false,
    "required": ["source_key", "name"],
    "properties": {
        "source_key": {
            "$ref": "common.schema.json#/$defs/source_key"
        },
        "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "\\S"
        },
        "is_active": {
            "type": "boolean"
        },
        "items": {
            "type": "array",
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
                "$ref": "common.schema.json#/$defs/label"
            }
        }
    }
}
